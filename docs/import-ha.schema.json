{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Opaland/Netatmo/docs/import-ha.schema.json",
  "title": "Statistiques Home Assistant importées (data/ha.enc.json déchiffré, S-1.18)",
  "type": "object",
  "required": ["sensors", "daily"],
  "additionalProperties": false,
  "properties": {
    "sensors": {
      "type": "object",
      "propertyNames": { "pattern": "^h[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["entity", "name", "kind", "unit"],
        "additionalProperties": false,
        "properties": {
          "entity": { "type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$" },
          "name": { "type": "string", "maxLength": 60 },
          "kind": { "enum": ["opening", "binary", "energy", "temperature", "humidity", "power", "numeric"] },
          "unit": { "type": "string", "maxLength": 12 }
        }
      }
    },
    "daily": {
      "type": "object",
      "propertyNames": { "pattern": "^h[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "object",
              "required": ["on_h", "n"],
              "additionalProperties": false,
              "properties": { "on_h": { "type": "number", "minimum": 0, "maximum": 25 }, "n": { "type": "integer", "minimum": 0 } }
            },
            {
              "type": "object",
              "required": ["kwh"],
              "additionalProperties": false,
              "properties": { "kwh": { "type": "number" } }
            },
            {
              "type": "object",
              "required": ["min", "max", "mean"],
              "additionalProperties": false,
              "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "mean": { "type": "number" } }
            }
          ]
        }
      }
    },
    "imported": { "type": "string", "format": "date-time" }
  }
}
