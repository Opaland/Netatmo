# Copier en .env pour lancer le collecteur en local (ce fichier .env n'est jamais commité).
INTUIS_USERNAME=vous@example.com
INTUIS_PASSWORD=
# Identifiants OAuth de l'application mobile Intuis (voir README, section « Identifiants d'application »)
INTUIS_CLIENT_ID=
INTUIS_CLIENT_SECRET=
# Phrase de passe qui chiffre les données publiées (longue : 5 mots ou plus)
DATA_PASSPHRASE=
# Optionnel : forcer la catégorie d'une pièce (heating, water_heater, ignore)
# INTUIS_ROOM_CATEGORIES={"1234567890": "water_heater"}
