{
  "name": "intuis-history-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node --import ./e2e/dist-a-jour.mjs e2e/demo.mjs",
    "e2e:features": "node --import ./e2e/dist-a-jour.mjs e2e/features.mjs",
    "e2e:composants": "node e2e/composants.mjs",
    "e2e:compteur": "node --import ./e2e/dist-a-jour.mjs e2e/compteur.mjs",
    "e2e:proche": "node --import ./e2e/dist-a-jour.mjs e2e/proche.mjs",
    "e2e:piece": "node --import ./e2e/dist-a-jour.mjs e2e/piece.mjs",
    "e2e:expliquer": "node --import ./e2e/dist-a-jour.mjs e2e/expliquer.mjs",
    "e2e:retours": "node --import ./e2e/dist-a-jour.mjs e2e/retours.mjs",
    "e2e:plannings": "node --import ./e2e/dist-a-jour.mjs e2e/plannings.mjs",
    "e2e:pwa": "node --import ./e2e/dist-a-jour.mjs e2e/pwa.mjs",
    "e2e:en-ligne": "node --import ./e2e/dist-a-jour.mjs e2e/en-ligne.mjs",
    "e2e:sweep": "node --import ./e2e/dist-a-jour.mjs e2e/sweep.mjs",
    "e2e:reglages": "node --import ./e2e/dist-a-jour.mjs e2e/reglages.mjs",
    "e2e:logement": "node --import ./e2e/dist-a-jour.mjs e2e/logement.mjs",
    "e2e:jeton": "node --import ./e2e/dist-a-jour.mjs e2e/jeton.mjs",
    "e2e:assistant": "node --import ./e2e/dist-a-jour.mjs e2e/assistant.mjs",
    "e2e:http": "node --import ./e2e/dist-a-jour.mjs e2e/http.mjs",
    "e2e:plan": "node --import ./e2e/dist-a-jour.mjs e2e/plan.mjs",
    "e2e:plan-edition": "node --import ./e2e/dist-a-jour.mjs e2e/plan-edition.mjs",
    "size": "node scripts/size-budget.mjs",
    "porte": "node ../scripts/porte.mjs",
    "porte:rapide": "node ../scripts/porte.mjs --rapide",
    "mutation": "npm i --no-save --no-audit --no-fund @stryker-mutator/core@10.1.1 @stryker-mutator/vitest-runner@10.1.1 && stryker run"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "hash-wasm": "4.12.0",
    "libsodium-wrappers": "^0.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "ajv": "^8.20.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
